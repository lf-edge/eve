+
+	if (!ima_eve_code_policy || !(ia_valid & ATTR_SIZE) ||
+	    !S_ISREG(inode->i_mode))
+		return;
+	iint = ima_iint_find(inode);
+	if (iint)
+		set_bit(IMA_CHANGE_DATA, &iint->atomic_flags);
+}
