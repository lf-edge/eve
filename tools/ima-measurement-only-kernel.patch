+/*
+ * memfd and inherited descriptors can be read without file_post_open.  Writes
+ * through a still-open descriptor must also invalidate its cached content.
+ * integrity_kernel_read() uses __kernel_read(), bypassing this hook, so the
+ * hash collection does not recursively measure its own reads.
+ */
+static int ima_eve_file_permission(struct file *file, int mask)
+{
+	struct inode *inode = file_inode(file);
+	struct ima_iint_cache *iint;
+
+	if (!ima_eve_code_policy || !S_ISREG(inode->i_mode))
+		return 0;
+
+	if ((mask & MAY_WRITE) ||
+	    ((mask & MAY_READ) && ((file->f_mode & FMODE_WRITE) ||
+	     inode_is_open_for_write(inode) ||
+	     mapping_writably_mapped(file->f_mapping)))) {
+		iint = ima_iint_find(inode);
+		if (iint)
+			set_bit(IMA_CHANGE_DATA, &iint->atomic_flags);
+	}
+	if (mask & MAY_READ)
+		return ima_file_check(file, mask);
+	return 0;
+}
