#include <tunables/global>

# No attachment path: AppArmor would otherwise also confine the swtpm that
# libvirt runs inside an unconfined KubeVirt virt-launcher pod on EVE-K, which
# keeps its state under /var/run/kubevirt-private and would be denied. Only the
# vtpm profile transitions into this profile by name.
profile swtpm {
    #include <abstractions/base>

    # allow necessary access for operations
    /usr/bin/swtpm                  rm,

    # to rw socket, log, etc files.
    owner /run/swtpm/{,*,**}        rwk,

    # to save/load tpm state for vms.
    owner /persist/swtpm/{,*,**}    rwk,

    # allow swtpm to receive term signal from vtpm
    signal (receive) set=(term) peer=vtpm,
}
