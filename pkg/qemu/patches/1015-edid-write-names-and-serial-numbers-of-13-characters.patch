From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mikhail Malyshev <mike.malyshev@gmail.com>
Date: Fri, 20 Nov 2026 15:37:03 +0000
Subject: [PATCH] edid: write names and serial numbers of 13 characters

An EDID text descriptor holds 13 characters; a shorter text ends with a
line feed and is padded with spaces. edid_desc_text() wrote 12 at most,
always followed by a line feed, so a monitor name of 13 characters lost
its last one, and EDID_NAME_MAX_LENGTH kept virtio-gpu output names to
12.

Write up to 13, with the line feed only after a shorter text, and allow
output names of 13.

Add a unit test for the EDID generator, which builds it the way
qemu-edid does, and check that virtio-gpu takes an output name of 13
characters whole and refuses a longer one.

Signed-off-by: Mikhail Malyshev <mike.malyshev@gmail.com>
Upstream-Status: Pending
---
 MAINTAINERS                     |  1 +
 hw/display/edid-generate.c      | 10 ++--
 include/hw/display/edid.h       |  2 +-
 tests/qtest/dbus-display-test.c | 47 +++++++++++++++++
 tests/unit/meson.build          |  1 +
 tests/unit/test-edid.c          | 90 +++++++++++++++++++++++++++++++++
 6 files changed, 145 insertions(+), 6 deletions(-)
 create mode 100644 tests/unit/test-edid.c

diff --git a/MAINTAINERS b/MAINTAINERS
index 902db77218..eecc166f86 100644
--- a/MAINTAINERS
+++ b/MAINTAINERS
@@ -2920,6 +2920,7 @@ S: Maintained
 F: hw/display/edid*
 F: include/hw/display/edid.h
 F: qemu-edid.c
+F: tests/unit/test-edid.c
 
 macOS PV Graphics (apple-gfx)
 M: Phil Dennis-Jordan <phil@philjordan.eu>
diff --git a/hw/display/edid-generate.c b/hw/display/edid-generate.c
index 5f631c3507..af49e457be 100644
--- a/hw/display/edid-generate.c
+++ b/hw/display/edid-generate.c
@@ -212,12 +212,12 @@ static void edid_desc_text(uint8_t *desc, uint8_t type,
     edid_desc_type(desc, type);
     memset(desc + 5, ' ', 13);
 
-    len = strlen(text);
-    if (len > 12) {
-        len = 12;
-    }
+    /* 13 characters fit; a shorter text ends with a line feed. */
+    len = strnlen(text, 13);
     memcpy(desc + 5, text, len);
-    desc[5 + len] = '\n';
+    if (len < 13) {
+        desc[5 + len] = '\n';
+    }
 }
 
 static void edid_desc_ranges(uint8_t *desc)
diff --git a/include/hw/display/edid.h b/include/hw/display/edid.h
index 9c4967d60f..71b8575139 100644
--- a/include/hw/display/edid.h
+++ b/include/hw/display/edid.h
@@ -1,7 +1,7 @@
 #ifndef EDID_H
 #define EDID_H
 
-#define EDID_NAME_MAX_LENGTH 12
+#define EDID_NAME_MAX_LENGTH 13
 
 /* The preferred mode of an EDID whose qemu_edid_info gives none */
 #define EDID_DEFAULT_PREFX 1280
diff --git a/tests/qtest/dbus-display-test.c b/tests/qtest/dbus-display-test.c
index 08d262f4d8..bf073c69c8 100644
--- a/tests/qtest/dbus-display-test.c
+++ b/tests/qtest/dbus-display-test.c
@@ -1230,6 +1230,51 @@ test_dbus_display_gpu_unchanged(void)
     test_gpu_stop(&t);
 }
 
+/* The 13 characters of the base-block text descriptor with @tag, or "". */
+static void
+test_edid_text(const uint8_t *edid, uint8_t tag, char text[14])
+{
+    text[0] = 0;
+    for (int i = 0; i < 4; i++) {
+        const uint8_t *desc = edid + 54 + 18 * i;
+
+        if (!desc[0] && !desc[1] && desc[3] == tag) {
+            memcpy(text, desc + 5, 13);
+            text[13] = 0;
+            return;
+        }
+    }
+}
+
+/* An output name of 13 characters is taken whole, and a longer one refused. */
+static void
+test_dbus_display_gpu_output_name(void)
+{
+    struct virtio_gpu_resp_edid resp = {};
+    TestGPU t = {};
+    char text[14];
+
+    if (g_test_subprocess()) {
+        qtest_quit(qtest_init("-vga none -device '{\"driver\":"
+                              " \"virtio-gpu-pci\", \"outputs\":"
+                              " [{\"name\": \"ABCDEFGHIJKLMN\"}]}'"));
+        return;
+    }
+    g_test_trap_subprocess(NULL, 0, 0);
+    g_test_trap_assert_failed();
+    g_test_trap_assert_stderr("*invalid output name*");
+
+    test_gpu_start_device(&t, "'{\"driver\": \"virtio-gpu-pci\","
+                              " \"addr\": \"04.0\","
+                              " \"outputs\": [{\"name\": \"ABCDEFGHIJKLM\"}]}'",
+                          1);
+    test_gpu_edid(&t, 0, &resp);
+    test_edid_text(resp.edid, 0xfc, text);
+    g_assert_cmpstr(text, ==, "ABCDEFGHIJKLM");
+
+    test_gpu_stop(&t);
+}
+
 static gsize
 get_console_ids_count(GDBusConnection *conn)
 {
@@ -1360,6 +1405,8 @@ main(int argc, char **argv)
                        test_dbus_display_gpu_outputs_configured);
         qtest_add_func("/dbus-display/gpu/unchanged",
                        test_dbus_display_gpu_unchanged);
+        qtest_add_func("/dbus-display/gpu/output-name",
+                       test_dbus_display_gpu_output_name);
     }
     if (qtest_has_machine("q35") && qtest_has_device("bochs-display")) {
         qtest_add_func("/dbus-display/hotplug", test_dbus_display_hotplug);
