From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mikhail Malyshev <mike.malyshev@gmail.com>
Date: Mon, 23 Nov 2026 12:00:28 +0000
Subject: [PATCH] edid: keep the monitor's name and serial number in the base
 block

The base EDID block has room for four 18-byte descriptors. With a
detailed timing for the preferred mode, the established timings III,
the range limits and the monitor name filled it, so a serial number
string - qemu-edid sets one with -s - went to the CTA extension, or was
left out of an EDID without one. E-EDID places a monitor's name and
serial number in the base block, and that is where guests look for
them to tell monitors apart; not all of them read the extension.

Place the established timings III after the name and serial number
instead. Without a serial number string they stay in the base block,
last, after the range limits and the name. With one they move, as they
are, to the extension, or
are left out of an EDID without one: a guest that reads only the base
block then no longer sees the modes listed only there, 1280x768,
1360x768, 1400x1050, 1792x1344, 1856x1392 and 1920x1440, and does see
which monitor it is.

Signed-off-by: Mikhail Malyshev <mike.malyshev@gmail.com>
Upstream-Status: Pending
---
 hw/display/edid-generate.c | 15 +++++++--
 tests/unit/test-edid.c     | 66 ++++++++++++++++++++++++++++++++++++++
 2 files changed, 78 insertions(+), 3 deletions(-)

diff --git a/hw/display/edid-generate.c b/hw/display/edid-generate.c
index 0824580071..5f68147b67 100644
--- a/hw/display/edid-generate.c
+++ b/hw/display/edid-generate.c
@@ -383,7 +383,7 @@ void qemu_edid_generate(uint8_t *edid, size_t size,
 {
     Timings timings;
     uint8_t *desc = edid + 54;
-    uint8_t *xtra3 = NULL;
+    uint8_t xtra3[18] = { 0 };
     uint8_t *dta = NULL;
     uint8_t *did = NULL;
     uint32_t width_mm, height_mm;
@@ -504,9 +504,7 @@ void qemu_edid_generate(uint8_t *edid, size_t size,
         desc = edid_desc_next(edid, dta, desc);
     }
 
-    xtra3 = desc;
     edid_desc_xtra3_std(xtra3);
-    desc = edid_desc_next(edid, dta, desc);
     edid_fill_modes(edid, xtra3, dta, info->maxx, info->maxy);
     /*
      * dta video data block is finished at thus point,
@@ -526,6 +524,17 @@ void qemu_edid_generate(uint8_t *edid, size_t size,
         desc = edid_desc_next(edid, dta, desc);
     }
 
+    /*
+     * The base block has room for four descriptors, and guests look for the
+     * monitor's name and serial number there: the established timings III
+     * come after them, in the extension when the base block is full, and
+     * are left out of an EDID without one.
+     */
+    if (desc) {
+        memcpy(desc, xtra3, sizeof(xtra3));
+        desc = edid_desc_next(edid, dta, desc);
+    }
+
     while (desc) {
         edid_desc_dummy(desc);
         desc = edid_desc_next(edid, dta, desc);
diff --git a/tests/unit/test-edid.c b/tests/unit/test-edid.c
index 8a81726e57..0c4df412ec 100644
--- a/tests/unit/test-edid.c
+++ b/tests/unit/test-edid.c
@@ -31,6 +31,19 @@ static const uint8_t *find_base_desc(const uint8_t *edid, uint8_t tag)
     return NULL;
 }
 
+/* A descriptor with @tag in the CTA extension, or NULL. */
+static const uint8_t *find_cta_desc(const uint8_t *edid, uint8_t tag)
+{
+    const uint8_t *dta = edid + 128;
+
+    for (int off = dta[2]; off && off + 18 <= 127; off += 18) {
+        if (desc_tag(dta + off) == tag) {
+            return dta + off;
+        }
+    }
+    return NULL;
+}
+
 static void check_checksums(const uint8_t *edid, size_t size)
 {
     for (size_t b = 0; b < size / 128 && b <= edid[126]; b++) {
@@ -103,12 +116,65 @@ static void test_edid_max(void)
     g_assert_false(has_std_4_3(edid, 1600));
 }
 
+static void check_base_tags(const uint8_t *edid, const uint8_t tags[4])
+{
+    for (int i = 0; i < 4; i++) {
+        g_assert_cmphex(desc_tag(base_desc(edid, i)), ==, tags[i]);
+    }
+}
+
+/*
+ * The monitor's name and serial number stay in the base block; the
+ * established timings III (0xf7) give way, unchanged.
+ */
+static void test_edid_placement(void)
+{
+    uint8_t edid[384], f7[18];
+    const uint8_t *ext_f7;
+    qemu_edid_info fhd_serial = {
+        .name = "Monitor", .serial = "SN1", .prefx = 1920, .prefy = 1080,
+    };
+    qemu_edid_info fhd = { .name = "Monitor", .prefx = 1920, .prefy = 1080 };
+    qemu_edid_info uhd_serial = {
+        .name = "Monitor", .serial = "SN1", .prefx = 3840, .prefy = 2160,
+    };
+
+    /* No serial number: everything fits, the timings III last. */
+    generate(edid, EDID_SIZE, &fhd);
+    check_base_tags(edid, (const uint8_t[]){ 0, 0xfd, 0xfc, 0xf7 });
+    memcpy(f7, base_desc(edid, 3), sizeof(f7));
+    /* Revision 10, with the modes the standard timings have no room for */
+    g_assert_cmpuint(f7[5], ==, 10);
+    g_assert_cmphex(f7[6], ==, 0);
+    g_assert_cmphex(f7[7], ==, 0x40);          /* 1280x768 */
+    g_assert_cmphex(f7[8], ==, 0x82);          /* 1360x768, 1400x1050 */
+    g_assert_cmphex(f7[9], ==, 0);
+    g_assert_cmphex(f7[10], ==, 0x28);         /* 1792x1344, 1856x1392 */
+    g_assert_cmphex(f7[11], ==, 0x20);         /* 1920x1440 */
+
+    /* With one: the base block is full, the timings III move on. */
+    generate(edid, EDID_SIZE, &fhd_serial);
+    check_base_tags(edid, (const uint8_t[]){ 0, 0xfd, 0xfc, 0xff });
+    ext_f7 = find_cta_desc(edid, 0xf7);
+    g_assert_nonnull(ext_f7);
+    g_assert_cmpmem(ext_f7, 18, f7, sizeof(f7));
+
+    /* No extension to move to: the timings III are left out. */
+    generate(edid, 128, &fhd_serial);
+    check_base_tags(edid, (const uint8_t[]){ 0, 0xfd, 0xfc, 0xff });
+
+    /* A large screen has no detailed timing in the base block. */
+    generate(edid, sizeof(edid), &uhd_serial);
+    check_base_tags(edid, (const uint8_t[]){ 0xfd, 0xfc, 0xff, 0xf7 });
+}
+
 int main(int argc, char **argv)
 {
     g_test_init(&argc, &argv, NULL);
 
     g_test_add_func("/edid/text", test_edid_text);
     g_test_add_func("/edid/max", test_edid_max);
+    g_test_add_func("/edid/placement", test_edid_placement);
 
     return g_test_run();
 }
